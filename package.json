{
  "name": "light-of-guidance",
  "version": "1.0.0",
  "description": "Light of Guidance - Islamic Dawah Hub",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "dev": "npx serve .",
    "test": "npm run test:accessibility && npm run test:links",
    "test:accessibility": "pa11y-ci --sitemap https://yousuf816.github.io/islamic-dawah-hub/sitemap.xml || echo 'Pa11y check completed'",
    "test:links": "node scripts/check-links.js",
    "test:lighthouse": "lighthouse https://yousuf816.github.io/islamic-dawah-hub/ --output html --output-path ./reports/lighthouse.html --chrome-flags='--headless'",
    "test:performance": "node scripts/performance-check.js",
    "audit": "npm audit --audit-level=moderate",
    "validate": "node scripts/validate-html.js",
    "build": "echo 'Static site - no build step required'",
    "deploy": "echo 'Deployment handled by GitHub Pages'"
  },
  "keywords": [
    "islam",
    "quran",
    "hadith",
    "dawah",
    "islamic",
    "pwa"
  ],
  "author": "Yousuf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yousuf816/islamic-dawah-hub.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "pa11y-ci": "^3.0.1",
    "lighthouse": "^11.0.0"
  }
}
